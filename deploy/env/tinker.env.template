# Tinker production environment — TEMPLATE ONLY
#
# Copy to /etc/tinker/tinker-mcp.env, replace every __PLACEHOLDER__,
# then `chown root:tinker /etc/tinker/tinker-mcp.env && chmod 0600 ...`.
#
# STRICT RULE: secrets come from the environment, never from the repo.
# This file is a template — it must never contain a real secret, and the
# filled-in copy must never be committed. See SECRETS.md next to this file.
#
# Sections: (A) required for `tinker-mcp serve`; (B) file backend;
# (C) model providers (item 24, optional); (D) operational tuning.

# ---------------------------------------------------------------- A --
# Postgres. Owner URLs run migrations + verify C6 keys (needs the
# owner role); app URLs serve tenant traffic under RLS (least
# privilege). Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# (URL-encode special characters in passwords).
TINKER_CORE_OWNER_URL=postgres://tinker_core:__CORE_OWNER_PASSWORD__@127.0.0.1:5432/tinker_core
TINKER_CORE_URL=postgres://tinker_app:__CORE_APP_PASSWORD__@127.0.0.1:5432/tinker_core
TINKER_PII_OWNER_URL=postgres://tinker_pii:__PII_OWNER_PASSWORD__@127.0.0.1:5432/tinker_pii
TINKER_PII_URL=postgres://tinker_pii_app:__PII_APP_PASSWORD__@127.0.0.1:5432/tinker_pii

# Key-encryption key for PII at rest (tinker-vault). 32 random bytes,
# base64-encoded. ROTATION: set TINKER_KEK to the new key and
# TINKER_KEK_PREVIOUS to the old one; the vault tries current, then
# previous; drop _PREVIOUS after re-encryption completes.
TINKER_KEK=__BASE64_32_BYTES__
#TINKER_KEK_PREVIOUS=__OLD_BASE64_32_BYTES__

# ---------------------------------------------------------------- B --
# File backend (item 42). `fs` keeps blobs under TINKER_FILE_ROOT on
# local disk (must be on the persistent volume and backed up); `s3`
# needs the TINKER_S3_* set below.
TINKER_FILE_BACKEND=fs
TINKER_FILE_ROOT=/opt/tinker/var/files
# Cap per-file bytes (default comes from the binary if unset).
#TINKER_MAX_FILE_BYTES=52428800

# S3 backend — required when TINKER_FILE_BACKEND=s3, ignored otherwise.
#TINKER_S3_ENDPOINT=https://s3.__REGION__.amazonaws.com
#TINKER_S3_REGION=us-east-1
#TINKER_S3_BUCKET=__BUCKET_NAME__
#TINKER_S3_ACCESS_KEY=__ACCESS_KEY__
#TINKER_S3_SECRET_KEY=__SECRET_KEY__
#TINKER_S3_SSE=aws:kms

# ---------------------------------------------------------------- C --
# Redis: session store + tinker-web signal bus. Password must match
# `requirepass` in deploy/redis/redis.conf. URL-encode special chars.
TINKER_REDIS_URL=redis://:__REDIS_PASSWORD__@127.0.0.1:6379/

# ---------------------------------------------------------------- D --
# Model providers (item 24, OpenAI-compatible /v1/chat/completions).
# One group per provider; NAME is upper-snake (e.g. ACME). Keys come
# from the environment only — never logs, never errors.
#TINKER_PROVIDER_ACME_BASE_URL=https://api.acme.example/v1
#TINKER_PROVIDER_ACME_API_KEY=__PROVIDER_API_KEY__
#TINKER_PROVIDER_ACME_MODEL=acme-large-2026
#TINKER_PROVIDER_ACME_PLACEMENT=org-controlled
#TINKER_PROVIDER_ACME_TIMEOUT_SECS=30
#TINKER_PROVIDER_ACME_MAX_RETRIES=2

# ---------------------------------------------------------------- E --
# Operational tuning (all optional; defaults are the dev-tested values).
# Inbound webhook HMAC secret (tinker-comms email ingress).
#TINKER_INBOUND_WEBHOOK_SECRET=__WEBHOOK_SECRET__
# Inbound attachment caps.
#TINKER_INBOUND_MAX_ATTACHMENTS=10
#TINKER_INBOUND_MAX_ATTACHMENT_BYTES=10485760
#TINKER_INBOUND_MAX_TOTAL_ATTACHMENT_BYTES=52428800
#TINKER_INBOUND_REPLAY_SECS=300
# Snapshot signing key (durable snapshots).
#TINKER_SNAPSHOT_SIGNING_KEY=__BASE64_32_BYTES__
# Semantic search provider selector.
#TINKER_SEMANTIC_SEARCH_PROVIDER=none
# Rust log filter for the service (no secrets in logs, ever).
RUST_LOG=info

# --------------------------------------------------------------------
# NOT read by `tinker-mcp serve` (documented so nobody wires them wrong):
# - TINKER_API_KEY: stdio mode only; serve mode takes the key per
#   request as `Authorization: Bearer`. Do NOT set it here.
# - TINKER_TEST_REDIS_URL: test-suite only (dev port 16379). Tests must
#   never run against this production file.
# - The `tinker` WEB binary (tinker-web) has a DIFFERENT contract — do
#   not copy this file for it:
#     TINKER_CORE_URL  = owner-role operational store (migrations)
#     TINKER_APP_URL   = tenant-facing app-role pool (RLS)
#     TINKER_HOST      = public host name (mandatory host context)
#     TINKER_ADDR      = listen address (default 127.0.0.1:8080)
#     TINKER_COOKIE_SECURE (default on; set 0 only for plain-HTTP dev)
#     TINKER_REDIS_URL = same redis (SSE signal bus fan-out)
#     OIDC_ISSUER / OIDC_AUDIENCE / OIDC_RSA_PEM = OIDC login (note: NO
#       TINKER_ prefix on these three)
#   This R5 package deploys `tinker-mcp serve` only.
